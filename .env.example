# Developer .env example — NOT shipped in the user zip.
# End-user template: deploy/release/templates/env.example
# Isolation rules: docs/DEV_VS_USER.md
#
# Copy to <COARA_HOME>/system/.env (or use release/templates/env.example for a clean user-like setup).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
# Agnes AI — providers.yaml `agnes` (default https://apihub.agnes-ai.cn/v1)
# Intl key also works on apihub.agnes-ai.com/v1; domestic key → api.agnes-ai.cn/v1 only
AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1

# Doubao Search (Volcengine) — 500 free searches/month
# https://console.volcengine.com/search-infinity/web-search-exp
# DOUBAO_API_KEY=

# Matrix — PC coara talks to local GoMatrix; phone App uses Dashboard tunnel QR
COARA_MATRIX_HOMESERVER=http://127.0.0.1:8008
COARA_MATRIX_USER=@coara:coara.local
COARA_MATRIX_PASSWORD=coara-bot-password

# Encrypted personal vault (auto-unlock on startup; password never enters LLM context)
# COARA_VAULT_PASSWORD=

# Email auto-configuration (optional)
# COARA_EMAIL=your_email@qq.com
# COARA_EMAIL_PASSWORD=your_auth_code
# COARA_EMAIL_IMAP_SERVER=imap.qq.com
# COARA_EMAIL_SMTP_SERVER=smtp.qq.com
# COARA_EMAIL_SMTP_PORT=465
