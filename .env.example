# Developer .env example — NOT shipped in the user zip.
# End-user template: deploy/official/templates/env.example
# Isolation: deploy/official/RELEASE_WORKFLOW.md §配置隔离
#
# Copy to <COARA_HOME>/system/.env（API key 唯一落点）.

# ------------ LLM 密钥 ------------
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
# Agnes 对话（providers.yaml `agnes`；配置页「模型」）
# AGNES_API_KEY=
# AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# LongCat / MiMo / SiliconFlow / Cloudflare 等按需
# LONGCAT_API_KEY=
# XIAOMIMIMO_API_KEY=
# SILICONFLOW_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ------------ 工具密钥（配置页「工具」；与 LLM 变量名分开，值可以相同）------------
# ------------ 搜索 ------------
# TAVILY_API_KEY=
# EXA_API_KEY=
# LINKUP_API_KEY=
# FIRECRAWL_API_KEY=
# SERPER_API_KEY=
# SEARCHAPI_KEY=
# Doubao Search (Volcengine) — https://console.volcengine.com/search-infinity/web-search-exp
# DOUBAO_API_KEY=

# ------------ 媒体 ------------
# Agnes 生图/视频（media；配置页「工具」）
# AGNES_MEDIA_API_KEY=

# ------------ 邮件 ------------
# COARA_EMAIL=your_email@qq.com
# COARA_EMAIL_PASSWORD=your_auth_code
# COARA_EMAIL_IMAP_SERVER=imap.qq.com
# COARA_EMAIL_SMTP_SERVER=smtp.qq.com
# COARA_EMAIL_SMTP_PORT=465

# ------------ Matrix ------------
# PC coara ↔ 本地 GoMatrix；手机 App 经 Dashboard 隧道扫码
COARA_MATRIX_HOMESERVER=http://127.0.0.1:8008
COARA_MATRIX_USER=@coara:coara.local
COARA_MATRIX_PASSWORD=coara-bot-password

# ------------ 飞书 ------------
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ------------ 其他 ------------
