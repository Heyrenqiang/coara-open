# LLM provider connections (protocol endpoints + credentials)
#
# END-USER DEFAULTS (shipped in the zip) live ONLY in:
#   deploy/official/templates/providers.yaml
# Do NOT copy this file into the release bundle. See deploy/official/RELEASE_WORKFLOW.md.
#
# This *.example is for editable/dev setups that want a richer catalog.
# For a user-identical COARA_HOME, copy from deploy/official/templates/ instead.
#
# Best practices (DeepSeek + Kimi + 智谱 + MiniMax):
# - Per-model context_window (input budget) / max_tokens (output cap) / temperature:
#   set on models.available[] entries below. UI status bar uses context_window, not max_tokens.
#   /model switches adopt the *target* model's settings (never carry the previous vendor's).
#   Resolution + hard caps: src/llm/call_defaults.py.
# - MiniMax (Responses 兼容端 https://api.minimaxi.com/v1)：
#   * temperature: [0, 2], default/recommended 1.0；keep 1.0 for general chat/tool loops。
#   * max_tokens: M3 supports up to 512K output tokens。Per-profile:
#     chat/tools 8192-16384, coding/agentic 16384-65536, long docs up to 131072。
#   * 推理：M3 省略 reasoning 默认关；coara 默认开启（reasoning.effort=low，
#     src/llm/vendor_options.py），/thinking off 关闭（effort=none）。
# - Kimi（OpenAI 兼容端 https://api.kimi.com/coding/v1）：
#   * k3 / kimi-for-coding：temperature 恒 1.0；K3 思考档位 reasoning_effort
#     （low/high/max）由 src/llm/vendor_options.py 注入；/thinking off 仅不传档位。
# - agent.main max_tokens follows the selected model's available[] / call_defaults entry.
#
# See docs/CONFIGURATION.md §3.1 (LLM profiles)

default_profile: agent.main
# Align with official/templates: leave empty so first-run wizard / heal picks a keyed provider.
default_provider: ""
default_model: ""

providers:
  # /model list pins deepseek → kimi → zhipu → minimax first (see src/llm/model_catalog.py)
  deepseek:
    driver: responses
    base_url: "https://api.deepseek.com"
    api_key_env: "DEEPSEEK_API_KEY"
    default_model: "deepseek-flash"
    models:
      default: "deepseek-flash"
      available:
        - id: "deepseek-flash"
          name: "DeepSeek V4.1 Flash"
          description: "1M context / 384K max output；原生多模态；思考/非思考双模式"
          function_calling: true
          vision: true
          context_window: 1000000
          max_tokens: 393216
          temperature: 1.0
          pricing:
            input: 1
            cache_hit: 0.02
            output: 4

  kimi:
    driver: openai
    base_url: "https://api.kimi.com/coding/v1"
    api_key_env: "KIMI_API_KEY"
    max_tokens: 131072
    default_model: "k3"
    models:
      default: "k3"
      available:
        - id: "k3"
          name: "Kimi K3"
          description: "Kimi K3 旗舰 — 最高 1M 上下文；思考档位 low/high/max。"
          function_calling: true
          context_window: 1048576
          max_tokens: 131072
          temperature: 1.0
          pricing:
            input: 20.0
            cache_hit: 2.0
            output: 100.0

  zhipu:
    driver: responses
    # Coding Plan / Codex：https://open.bigmodel.cn/api/v1（wire_api=responses）
    # Chat Completions 套餐：…/api/coding/paas/v4 + driver openai
    base_url: "https://open.bigmodel.cn/api/v1"
    api_key_env: "ZHIPU_API_KEY"
    max_tokens: 131072
    default_model: "glm-5.3"
    models:
      default: "glm-5.3"
      available:
        - id: "glm-5.3"
          name: "智谱 GLM-5.3"
          description: "1M context；128K max output；Responses API + reasoning.effort"
          function_calling: true
          context_window: 1000000
          max_tokens: 131072
          temperature: 1.0
          pricing:
            input: 8.0
            cache_hit: 2.0
            output: 28.0

  minimax:
    driver: responses
    base_url: "https://api.minimaxi.com/v1"
    api_key_env: "MINIMAX_API_KEY"
    # Provider-level ceiling; per-profile/model max_tokens takes precedence.
    # Model-aware fallback (M3 131072) lives in src/llm/call_defaults.py.
    max_tokens: 131072
    default_model: "MiniMax-M3"
    models:
      default: "MiniMax-M3"
      available:
        - id: "MiniMax-M3"
          name: "MiniMax M3"
          description: "1M context; agentic reasoning and coding."
          function_calling: true
          context_window: 1000000
          max_tokens: 131072
          temperature: 1.0
          # ≤512k 输入、标准层、永久五折后（元/百万）。>512k 翻倍；priority ×1.5。
          # https://platform.minimaxi.com/docs/guides/pricing-paygo
          pricing:
            input: 2.10
            cache_hit: 0.42
            output: 8.40

llm_profiles:
  agent.main:
    provider: minimax
    model: MiniMax-M3
    max_tokens: 131072
    temperature: 1.0
    top_p: 0.95
  agent.minimax:
    provider: minimax
    model: MiniMax-M3
    # Official MiniMax M3 defaults: temperature=1.0, top_p=0.95.
    # max_tokens 131072 is coara's practical default for M3 (official ceiling ~512K).
    max_tokens: 131072
    temperature: 1.0
    top_p: 0.95
  agent.minimax_m3:
    provider: minimax
    model: MiniMax-M3
    # Official MiniMax defaults: temperature=1.0, top_p=0.95 (M3).
    # max_tokens 131072 is coara's practical default for M3 (official ceiling ~512K).
    max_tokens: 131072
    temperature: 1.0
    top_p: 0.95
  agent.deepseek:
    provider: deepseek
    model: deepseek-flash
    max_tokens: 393216
    temperature: 1.0
  agent.kimi:
    provider: kimi
    model: k3
    max_tokens: 131072
    temperature: 1.0
  agent.zhipu:
    provider: zhipu
    model: glm-5.3
    max_tokens: 131072
    temperature: 1.0
  agent.web_search:
    inherit: agent.main
    max_tokens: 4096
    temperature: 0.3
  context.compression:
    inherit: agent.main
    max_tokens: 2048
    temperature: 0.2
  workflow.node:
    provider: minimax
    model: MiniMax-M3
    max_tokens: 131072
    temperature: 1.0
    top_p: 0.95

security:
  call_policy:
    auto_allow:
      - read
      - grep
      - glob
      - web_search
      - web_fetch
      - todo
      - task
      - delegate
      - ask_user
      - skill
      - workflow
      - tool
    prompt_low:
      - shell
